BUTLER(S=4) = Seated[0],
Seated[0] = (sitdown -> Seated[1]),
Seated[i:1..S-1] = ( 
	sitdown -> Seated[i+1] | 
	arise -> Seated[i-1]),
Seated[S] = (arise -> Seated[S-1]).

||SITTING(N=5) = ({phil[i:0..N-1]}::BUTLER(N-1)).

FORK = (get -> put -> FORK).

PHIL = (sitdown -> right.get -> left.get
-> eat
-> left.put -> right.put
-> arise -> PHIL).

||DINERS(N=5) = forall [i:0..N-1] (phil[i]:PHIL || {phil[i].left, phil[((i-1)+N)%N].right}::FORK
|| SITTING(N)).